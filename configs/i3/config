set $mod Mod4

font pango:JetBrainsMono Nerd Font Mono 8

exec --no-startup-id dex --autostart --environment i3

exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork -e -i $HOME/dots/walls/computer.png
exec --no-startup-id xset s 300 5

exec --no-startup-id nm-applet
exec --no-startup-id picom
exec --no-startup-id copyq
exec --no-startup-id "xwallpaper --zoom $HOME/dots/walls/win7/win7wallpaper.png"
exec --no-startup-id dunst
exec --no-startup-id upower-notify
exec --no-startup-id polybar
exec --no-startup-id sxhkd


bindsym super + space "rofi -modi drun,run -show drun"
